# Copy to .env and fill in the keys you use.
# Never commit real API keys.

# OpenAI — Whisper transcription (voicewire transcribe / run)
OPENAI_API_KEY=

# Optional Whisper model override (default: whisper-1)
# VOICEWIRE_WHISPER_MODEL=whisper-1

# Anthropic — Claude translation (voicewire translate / run)
ANTHROPIC_API_KEY=

# Optional Claude model override (default: claude-3-5-haiku-latest)
# VOICEWIRE_CLAUDE_MODEL=claude-3-5-haiku-latest
