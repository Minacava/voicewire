{
  "name": "voicewire",
  "version": "0.1.0",
  "description": "CLI for browser mic capture, Whisper speech-to-text, and Claude translation.",
  "license": "MIT",
  "author": "Marina Camacho",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Minacava/voicewire.git"
  },
  "bugs": {
    "url": "https://github.com/Minacava/voicewire/issues"
  },
  "homepage": "https://github.com/Minacava/voicewire#readme",
  "keywords": [
    "cli",
    "speech-to-text",
    "whisper",
    "translation",
    "claude",
    "browser-capture",
    "voicewire"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "voicewire": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "public",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-public.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test 'test/**/*.test.js'",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "dotenv": "^17.4.2",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^5.8.2"
  }
}
